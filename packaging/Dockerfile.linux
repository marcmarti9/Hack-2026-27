FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils libegl1 libgl1 libdbus-1-3 libfontconfig1 libglib2.0-0 libx11-xcb1 \
    libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
    libxcb-render-util0 libxcb-shape0 libxcb-xkb1 libxkbcommon-x11-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /vigia
COPY requirements.txt requirements-desktop.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt -r requirements-desktop.txt
COPY apps apps
COPY scripts scripts
COPY packaging packaging
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
