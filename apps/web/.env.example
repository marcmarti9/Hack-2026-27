# Copia este fichero como .env y pon tu clave. Nunca subas .env a Git.
# OpenAI (por defecto). La clave se crea en platform.openai.com; se factura aparte de la suscripción de ChatGPT.
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-6-luna            # investigador N1, informe N2 y chat
# OPENAI_REVIEW_MODEL=gpt-6.1-sol    # fiscal
# VIGIA_RAZONAMIENTO=low             # low | medium | high (más lento y más caro)
# Claude (opcional): ANTHROPIC_API_KEY=sk-ant-...  y  VIGIA_PROVEEDOR=claude
# VIGIA_MOCK=1  -> modo demo sin API (agentes simulados con datos reales)
VIGIA_MOCK=0
