# Opcional. Copia a .env para cambiar estos valores.
VIGIA_PORT=8501

# heuristic = línea base local sin IA; anthropic = análisis con un modelo remoto.
# El modo anthropic envía el contexto de las alertas al proveedor.
LLM_MODE=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

CONFIDENCE_THRESHOLD=0.7
CRITICAL_CONFIDENCE=0.9
MIN_EVIDENCES_RED=2
